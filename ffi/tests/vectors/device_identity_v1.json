{
  "format": "lengsuo-device-identity-vectors",
  "version": 1,
  "spec": "设备身份校验规则（设备 ID / 公钥 / NAT 候选）+ 本地错误码映射",
  "notes": [
    "跨端测试向量：Swift / Kotlin 侧读**同一份**文件逐条对拍。",
    "expect_valid=true ⇒ expect_code=0 且 expect_stable_name 为空。",
    "expect_canonical：合法输入的规范化结果（公钥为 trim 后文本）。"
  ],
  "error_codes": {
    "InvalidDeviceId": 50100,
    "InvalidPublicKey": 50102,
    "InvalidCandidate": 50104,
    "DeviceOwnershipConflict": 50105
  },
  "fnv1a64_golden": [
    {
      "input_hex": "",
      "expect_hex": "cbf29ce484222325"
    },
    {
      "input_hex": "61",
      "expect_hex": "af63dc4c8601ec8c"
    },
    {
      "input_hex": "666f6f626172",
      "expect_hex": "85944171f73967e8"
    }
  ],
