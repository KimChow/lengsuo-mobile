{
  "format": "lengsuo-coord-view-vectors",
  "version": 1,
  "spec": "coord-view: device/peer view, server-authoritative availability, local error codes",
  "notes": [
    "The server is the single source of truth for online; clients never infer it from last_seen_at_ms.",
    "online=false is a successful response (device exists but heartbeat timed out), not a parse error.",
    "public_key_fingerprint is FNV-1a 64-bit display-only, 16 lowercase hex chars; it is not a cryptographic digest.",
    "A missing authoritative answer (unreachable / error / unparseable) is Unknown and must never become Online.",
    "expect_code=0 means accepted; otherwise expect_stable_name and expect_code are the cross-end contract."
  ],
  "error_codes": {
    "InvalidDeviceId": 50100,
    "InvalidPublicKey": 50102,
    "InvalidFingerprint": 50102,
    "UnknownDevice": 50101,
    "BindingMismatch": 50117,
    "DeviceOffline": 50004
  },
  "fnv1a64_golden": [
    {
      "input_hex": "",
      "expect_hex": "cbf29ce484222325"
    },
    {
      "input_hex": "61",
      "expect_hex": "af63dc4c8601ec8c"
    },
    {
      "input_hex": "666f6f626172",
      "expect_hex": "85944171f73967e8"
    },
    {
      "input_hex": "3031323334353637383961626364656630313233343536373839616263646566",
      "expect_hex": "01527c9731f0ff55"
    }
  ],
